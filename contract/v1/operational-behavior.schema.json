{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simpler.grants.gov/form-spec/contract/v1/operational-behavior.schema.json",
  "title": "Portable operational behavior",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "formId", "behaviors"],
  "properties": {
    "contract": { "const": "grants-form-operational-behavior/v1" },
    "formId": { "type": "string", "minLength": 1 },
    "behaviors": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/behavior" }
    }
  },
  "$defs": {
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalPath",
        "operationKind",
        "valueSource",
        "editability",
        "executionPolicy"
      ],
      "properties": {
        "canonicalPath": { "type": "string", "pattern": "^/(?:[^/]+(?:/[^/]+)*)?$" },
        "operationKind": { "const": "prefill" },
        "valueSource": { "$ref": "#/$defs/canonicalValueSource" },
        "targetSelection": { "$ref": "#/$defs/targetSelection" },
        "editability": {
          "enum": ["editable", "read-only", "protected", "not-applicable", "unspecified"]
        },
        "executionPolicy": { "$ref": "#/$defs/executionPolicy" }
      }
    },
    "canonicalValueSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "blockId", "path"],
      "properties": {
        "kind": { "const": "canonical" },
        "blockId": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "pattern": "^/(?:[^/]+(?:/[^/]+)*)?$" }
      }
    },
    "targetSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arrayPath", "index"],
      "properties": {
        "arrayPath": { "type": "string", "pattern": "^/(?:[^/]+(?:/[^/]+)*)?$" },
        "index": { "type": "integer", "minimum": 0 }
      }
    },
    "executionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "writePolicy", "missingSourcePolicy"],
      "properties": {
        "trigger": { "const": "source-response-updated" },
        "writePolicy": { "const": "until-target-user-modified" },
        "missingSourcePolicy": { "const": "skip" }
      }
    }
  }
}
