{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simpler.grants.gov/form-spec/contract/v1/policy-binding.schema.json",
  "title": "Form policy and acceptance binding",
  "description": "Binds one versioned policy to a form's portable presentation and response pointers without embedding the policy text or a consumer-specific engine.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "formId", "policy", "presentation", "acceptance", "release"],
  "properties": {
    "contract": { "const": "form-policy-binding/v1" },
    "formId": { "type": "string", "minLength": 1 },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sections"],
      "properties": {
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sectionId", "name"],
            "properties": {
              "sectionId": { "type": "string", "minLength": 1 },
              "name": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 },
              "before": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event", "actor", "attestsTo", "fields"],
      "properties": {
        "event": { "enum": ["submission", "explicit-acceptance"] },
        "actor": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "attestsTo": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "pointer", "responseRole", "required"],
            "properties": {
              "role": { "enum": ["signature", "signerTitle", "applicantOrganization", "acceptedAt", "acceptance"] },
              "pointer": { "type": "string", "pattern": "^/(?:[^/~]|~[01])+(?:/(?:[^/~]|~[01])+)*$" },
              "responseRole": { "enum": ["applicantInput", "systemValue", "attestation"] },
              "required": { "type": "boolean" },
              "source": { "type": "string", "minLength": 1 },
              "editable": { "type": "boolean" }
            }
          }
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "gates"],
      "properties": {
        "status": { "enum": ["draft", "blocked", "reviewed", "released"] },
        "gates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "status"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "status": { "enum": ["pending", "blocked", "passed", "not-applicable"] },
              "note": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
