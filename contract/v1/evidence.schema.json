{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simpler.grants.gov/form-spec/contract/v1/evidence.schema.json",
  "title": "Portable source and semantic-review evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "block", "sources", "extraction", "semanticReview"],
  "properties": {
    "contract": { "const": "grants-form-evidence/v1" },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["question", "form"] },
        "formVersion": {
          "type": "string",
          "minLength": 1,
          "description": "Canonical form version whose emitted artifact this evidence describes. This is not a source document's native version."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "form" } },
            "required": ["kind"]
          },
          "then": {
            "properties": { "formVersion": true },
            "required": ["formVersion"]
          },
          "else": { "properties": { "formVersion": false } }
        }
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "uri", "nativeVersion", "sha256"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "enum": ["xsd", "dat", "pdf", "instructions", "implementation"] },
          "uri": { "type": "string", "pattern": "^https://" },
          "nativeVersion": {
            "type": ["string", "null"],
            "minLength": 1,
            "description": "Version stated by this exact source. Null means the source does not state a version or the native version is unknown; never inherit the canonical form version."
          },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "inheritsBehaviorEvidenceFrom": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/behaviorEvidenceInheritance" }
    },
    "inheritsOperationalBehaviorEvidenceFrom": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/operationalBehaviorEvidenceInheritance" }
    },
    "behaviorEvidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/behaviorEvidence" }
    },
    "operationalBehaviorEvidence": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/operationalBehaviorEvidence" }
    },
    "responseNormalizationEvidence": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/responseNormalizationEvidence" }
    },
    "extraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "artifact", "sourceSetSha256", "extractedAt"],
      "properties": {
        "repository": { "type": "string", "pattern": "^https://" },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "artifact": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "sourceSetSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "extractedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
        }
      }
    },
    "semanticReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "mappings"],
      "properties": {
        "status": { "enum": ["unreviewed", "proposed", "reviewed", "accepted", "rejected"] },
        "mappings": {
          "type": "array",
          "items": { "$ref": "#/$defs/mapping" }
        }
      }
    }
  },
  "$defs": {
    "responseNormalizationEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "canonicalPath",
        "operation",
        "authority",
        "reviewStatus",
        "sourceEvidence",
        "disposition"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "canonicalPath": {
          "type": "string",
          "pattern": "^/(?:[^/~]|~[01])+(?:/(?:[^/~]|~[01])+)*$"
        },
        "operation": { "const": "empty-string-to-absent" },
        "authority": { "const": "official_source" },
        "reviewStatus": { "const": "reviewed" },
        "sourceEvidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sourceId", "sourcePath", "sourceRecord"],
            "properties": {
              "sourceId": { "type": "string", "minLength": 1 },
              "sourcePath": { "type": "string", "minLength": 1 },
              "sourceRecord": { "type": "string", "minLength": 1 }
            }
          }
        },
        "disposition": { "type": "string", "minLength": 1 }
      }
    },
    "behaviorEvidenceInheritance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blockId", "mountPath"],
      "properties": {
        "blockId": { "type": "string", "minLength": 1 },
        "mountPath": { "type": "string" }
      }
    },
    "operationalBehaviorEvidenceInheritance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blockId", "mountPath"],
      "properties": {
        "blockId": { "type": "string", "minLength": 1 },
        "mountPath": { "type": "string", "pattern": "^(?:|/(?:[^/]+(?:/[^/]+)*))$" }
      }
    },
    "behaviorEvidence": {
      "oneOf": [
        { "$ref": "#/$defs/sourceBoundBehaviorEvidence" },
        { "$ref": "#/$defs/unresolvedBehaviorEvidence" }
      ]
    },
    "behaviorEvidenceBase": {
      "type": "object",
      "required": ["canonicalPath", "ruleKind", "authority"],
      "properties": {
        "canonicalPath": { "type": "string", "minLength": 1 },
        "ruleKind": { "enum": ["calculation", "condition"] },
        "authority": {
          "enum": ["official_source", "implementation_parity", "unresolved"]
        },
        "executionStatus": { "enum": ["compiled", "source-bound-uncompiled"] },
        "inheritedFrom": { "type": "string", "minLength": 1 }
      }
    },
    "sourceBoundBehaviorEvidence": {
      "allOf": [
        { "$ref": "#/$defs/behaviorEvidenceBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "canonicalPath", "ruleKind", "authority", "sourceId", "sourcePath", "sourceRecord"
          ],
          "properties": {
            "canonicalPath": { "type": "string", "minLength": 1 },
            "ruleKind": { "enum": ["calculation", "condition"] },
            "authority": { "enum": ["official_source", "implementation_parity"] },
            "sourceId": { "type": "string", "minLength": 1 },
            "sourcePath": { "type": "string", "minLength": 1 },
            "sourceRecord": { "type": "string", "minLength": 1 },
            "executionStatus": { "enum": ["compiled", "source-bound-uncompiled"] },
            "inheritedFrom": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "unresolvedBehaviorEvidence": {
      "allOf": [
        { "$ref": "#/$defs/behaviorEvidenceBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "canonicalPath", "ruleKind", "authority", "owner", "reason", "removalCondition"
          ],
          "properties": {
            "canonicalPath": { "type": "string", "minLength": 1 },
            "ruleKind": { "enum": ["calculation", "condition"] },
            "authority": { "const": "unresolved" },
            "owner": { "type": "string", "minLength": 1 },
            "reason": { "type": "string", "minLength": 1 },
            "removalCondition": { "type": "string", "minLength": 1 },
            "executionStatus": { "enum": ["compiled", "source-bound-uncompiled"] },
            "inheritedFrom": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "operationalBehaviorEvidence": {
      "oneOf": [
        { "$ref": "#/$defs/sourceBoundOperationalBehaviorEvidence" },
        { "$ref": "#/$defs/unresolvedOperationalBehaviorEvidence" }
      ]
    },
    "operationalBehaviorEvidenceBase": {
      "type": "object",
      "required": [
        "canonicalPath",
        "operationKind",
        "editability",
        "authority",
        "executionStatus"
      ],
      "properties": {
        "canonicalPath": { "type": "string", "pattern": "^/(?:[^/]+(?:/[^/]+)*)?$" },
        "operationKind": { "enum": ["prefill", "external-derived", "discard", "replace"] },
        "valueSource": { "$ref": "#/$defs/operationalValueSource" },
        "editability": { "enum": ["editable", "read-only", "protected", "not-applicable", "unspecified"] },
        "targetSelection": { "$ref": "#/$defs/operationalTargetSelection" },
        "authority": { "enum": ["official_source", "implementation_parity", "unresolved"] },
        "executionStatus": { "enum": ["compiled", "source-bound-uncompiled"] },
        "executionPolicy": { "$ref": "#/$defs/operationalExecutionPolicy" },
        "inheritedFrom": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "operationKind": { "enum": ["prefill", "external-derived", "replace"] }
            },
            "required": ["operationKind"]
          },
          "then": {
            "properties": { "valueSource": true },
            "required": ["valueSource"]
          }
        },
        {
          "if": {
            "properties": { "executionStatus": { "const": "compiled" } },
            "required": ["executionStatus"]
          },
          "then": {
            "properties": { "executionPolicy": true },
            "required": ["executionPolicy"]
          },
          "else": { "not": { "required": ["executionPolicy"] } }
        }
      ]
    },
    "operationalExecutionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "writePolicy", "missingSourcePolicy"],
      "properties": {
        "trigger": { "const": "source-response-updated" },
        "writePolicy": { "const": "until-target-user-modified" },
        "missingSourcePolicy": { "const": "skip" }
      }
    },
    "operationalValueSource": {
      "oneOf": [
        { "$ref": "#/$defs/canonicalOperationalValueSource" },
        { "$ref": "#/$defs/externalOperationalValueSource" }
      ]
    },
    "operationalTargetSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arrayPath", "index"],
      "properties": {
        "arrayPath": { "type": "string", "pattern": "^/(?:[^/]+(?:/[^/]+)*)?$" },
        "index": { "type": "integer", "minimum": 0 }
      }
    },
    "canonicalOperationalValueSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "blockId", "path"],
      "properties": {
        "kind": { "const": "canonical" },
        "blockId": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "pattern": "^/(?:[^/]+(?:/[^/]+)*)?$" }
      }
    },
    "externalOperationalValueSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "namespace", "path"],
      "properties": {
        "kind": { "const": "external" },
        "namespace": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 }
      }
    },
    "sourceBoundOperationalBehaviorEvidence": {
      "allOf": [
        { "$ref": "#/$defs/operationalBehaviorEvidenceBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "canonicalPath",
            "operationKind",
            "editability",
            "authority",
            "executionStatus",
            "sourceId",
            "sourcePath",
            "sourceRecord"
          ],
          "properties": {
            "canonicalPath": { "type": "string", "pattern": "^/(?:[^/]+(?:/[^/]+)*)?$" },
            "operationKind": { "enum": ["prefill", "external-derived", "discard", "replace"] },
            "valueSource": { "$ref": "#/$defs/operationalValueSource" },
            "editability": { "enum": ["editable", "read-only", "protected", "not-applicable", "unspecified"] },
            "targetSelection": { "$ref": "#/$defs/operationalTargetSelection" },
            "authority": { "enum": ["official_source", "implementation_parity"] },
            "executionStatus": { "enum": ["compiled", "source-bound-uncompiled"] },
            "executionPolicy": { "$ref": "#/$defs/operationalExecutionPolicy" },
            "inheritedFrom": { "type": "string", "minLength": 1 },
            "sourceId": { "type": "string", "minLength": 1 },
            "sourcePath": { "type": "string", "minLength": 1 },
            "sourceRecord": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "unresolvedOperationalBehaviorEvidence": {
      "allOf": [
        { "$ref": "#/$defs/operationalBehaviorEvidenceBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "canonicalPath",
            "operationKind",
            "editability",
            "authority",
            "executionStatus",
            "owner",
            "reason",
            "removalCondition"
          ],
          "properties": {
            "canonicalPath": { "type": "string", "pattern": "^/(?:[^/]+(?:/[^/]+)*)?$" },
            "operationKind": { "enum": ["prefill", "external-derived", "discard", "replace"] },
            "valueSource": { "$ref": "#/$defs/operationalValueSource" },
            "editability": { "enum": ["editable", "read-only", "protected", "not-applicable", "unspecified"] },
            "targetSelection": { "$ref": "#/$defs/operationalTargetSelection" },
            "authority": { "const": "unresolved" },
            "executionStatus": { "const": "source-bound-uncompiled" },
            "inheritedFrom": { "type": "string", "minLength": 1 },
            "owner": { "type": "string", "minLength": 1 },
            "reason": { "type": "string", "minLength": 1 },
            "removalCondition": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalPointer", "sourceId", "sourcePath", "status"],
      "properties": {
        "canonicalPointer": { "type": "string", "pattern": "^#(?:$|/)" },
        "sourceId": { "type": "string", "minLength": 1 },
        "sourcePath": { "type": "string", "minLength": 1 },
        "status": { "enum": ["proposed", "reviewed", "accepted", "rejected"] },
        "reviewedBy": { "type": "string", "minLength": 1 },
        "reviewedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
        },
        "note": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "accepted" } }, "required": ["status"] },
          "then": {
            "properties": {
              "reviewedBy": { "type": "string", "minLength": 1 },
              "reviewedAt": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
              }
            },
            "required": ["reviewedBy", "reviewedAt"]
          }
        }
      ]
    }
  }
}
