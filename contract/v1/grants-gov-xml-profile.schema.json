{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simpler.grants.gov/form-spec/contract/v1/grants-gov-xml-profile.schema.json",
  "title": "Portable Grants.gov XML target profile",
  "description": "A language-neutral mapping from one canonical form response to a Grants.gov XML document.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "formId", "xsd", "namespaces", "root", "mapping"],
  "properties": {
    "contract": { "const": "grants-gov-xml-profile/v1" },
    "formId": { "type": "string", "minLength": 1 },
    "xsd": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "sha256"],
      "properties": {
        "uri": { "type": "string", "pattern": "^https://" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "namespaces": {
      "type": "object",
      "minProperties": 1,
      "required": ["default"],
      "properties": {
        "default": { "type": "string", "pattern": "^https?://" }
      },
      "propertyNames": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$" },
      "additionalProperties": { "type": "string", "pattern": "^https?://" }
    },
    "root": {
      "type": "object",
      "additionalProperties": false,
      "required": ["element", "namespacePrefix", "attributes"],
      "properties": {
        "element": { "$ref": "#/$defs/xmlName" },
        "namespacePrefix": { "type": "string", "minLength": 1 },
        "attributes": { "$ref": "#/$defs/rootAttributes" }
      }
    },
    "attachment": { "$ref": "#/$defs/attachmentWire" },
    "mapping": { "$ref": "#/$defs/mapping" },
    "evidence": { "$ref": "#/$defs/sourceEvidence" }
  },
  "$defs": {
    "xmlName": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$" },
    "staticAttributes": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/xmlName" },
      "additionalProperties": {
        "anyOf": [
          { "type": "string" },
          { "type": "number" },
          { "type": "boolean" }
        ]
      }
    },
    "rootAttributes": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^(?:[A-Za-z_][A-Za-z0-9_.-]*:)?[A-Za-z_][A-Za-z0-9_.-]*$"
      },
      "additionalProperties": {
        "anyOf": [
          { "type": "string" },
          { "type": "number" },
          { "type": "boolean" }
        ]
      }
    },
    "literal": {
      "anyOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" }
      ]
    },
    "valueMap": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/literal" }
    },
    "attributeValue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": { "type": "string", "pattern": "^/" },
        "constant": { "$ref": "#/$defs/literal" },
        "valueMap": { "$ref": "#/$defs/valueMap" }
      },
      "oneOf": [
        { "properties": { "source": true }, "required": ["source"] },
        { "properties": { "constant": true }, "required": ["constant"] }
      ],
      "if": { "properties": { "valueMap": true }, "required": ["valueMap"] },
      "then": { "properties": { "source": true }, "required": ["source"] }
    },
    "dynamicAttributes": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/xmlName" },
      "additionalProperties": { "$ref": "#/$defs/attributeValue" }
    },
    "sourceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "repository", "revision", "artifact"],
      "properties": {
        "status": { "enum": ["source-bound-unreviewed", "reviewed"] },
        "repository": { "type": "string", "pattern": "^https://" },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "artifact": { "type": "string", "minLength": 1 }
      }
    },
    "attachmentField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["element", "namespace"],
      "properties": {
        "element": { "$ref": "#/$defs/xmlName" },
        "namespace": { "type": "string", "minLength": 1 }
      }
    },
    "attachmentWire": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields"],
      "properties": {
        "fields": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fileName", "mimeType", "fileLocation", "hashValue"],
          "properties": {
            "fileName": { "$ref": "#/$defs/attachmentField" },
            "mimeType": { "$ref": "#/$defs/attachmentField" },
            "fileLocation": { "$ref": "#/$defs/attachmentField" },
            "hashValue": { "$ref": "#/$defs/attachmentField" }
          }
        }
      }
    },
    "leafContainer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["element", "namespace"],
      "properties": {
        "element": { "$ref": "#/$defs/xmlName" },
        "namespace": { "type": "string", "minLength": 1 }
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields"],
      "properties": { "fields": { "$ref": "#/$defs/mappingFields" } }
    },
    "mappingFields": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
      "additionalProperties": { "$ref": "#/$defs/mappingNode" }
    },
    "mappingNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["element", "kind"],
      "properties": {
        "element": { "$ref": "#/$defs/xmlName" },
        "kind": { "enum": ["value", "object", "group", "array", "attachment"] },
        "flatten": { "type": "boolean" },
        "emitWhenParentPresent": { "type": "boolean" },
        "namespace": { "type": "string", "minLength": 1 },
        "container": { "$ref": "#/$defs/leafContainer" },
        "source": { "type": "string", "pattern": "^/" },
        "constant": { "$ref": "#/$defs/literal" },
        "valueMap": { "$ref": "#/$defs/valueMap" },
        "attributes": { "$ref": "#/$defs/dynamicAttributes" },
        "fields": { "$ref": "#/$defs/mappingFields" },
        "items": {
          "oneOf": [
            { "$ref": "#/$defs/mapping" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["node"],
              "properties": { "node": { "$ref": "#/$defs/mappingNode" } }
            }
          ]
        },
        "itemElement": { "$ref": "#/$defs/xmlName" },
        "itemNamespace": { "type": "string", "minLength": 1 },
        "itemAttributes": { "$ref": "#/$defs/staticAttributes" },
        "repeatElementPerItem": { "type": "boolean" }
      },
      "allOf": [
        {
          "not": {
            "properties": { "source": true, "constant": true },
            "required": ["source", "constant"]
          }
        },
        {
          "if": { "properties": { "valueMap": true }, "required": ["valueMap"] },
          "then": { "properties": { "source": true }, "required": ["source"] }
        },
        {
          "if": { "properties": { "constant": true }, "required": ["constant"] },
          "then": {
            "properties": { "kind": { "const": "value" } },
            "required": ["kind"]
          }
        },
        {
          "if": {
            "properties": { "kind": { "enum": ["object", "group"] } },
            "required": ["kind"]
          },
          "then": {
            "properties": { "fields": true },
            "required": ["fields"],
            "not": {
              "anyOf": [
                { "properties": { "items": true }, "required": ["items"] },
                { "properties": { "itemElement": true }, "required": ["itemElement"] },
                { "properties": { "itemNamespace": true }, "required": ["itemNamespace"] },
                { "properties": { "itemAttributes": true }, "required": ["itemAttributes"] },
                { "properties": { "repeatElementPerItem": true }, "required": ["repeatElementPerItem"] },
                { "properties": { "container": true }, "required": ["container"] }
              ]
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "array" } }, "required": ["kind"] },
          "then": {
            "properties": { "element": true, "items": true },
            "required": ["element", "items"],
            "not": {
              "anyOf": [
                { "properties": { "fields": true }, "required": ["fields"] },
                { "properties": { "container": true }, "required": ["container"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": { "emitWhenParentPresent": true },
            "required": ["emitWhenParentPresent"]
          },
          "then": {
            "properties": { "kind": { "const": "object" } },
            "required": ["kind"]
          }
        },
        {
          "if": {
            "properties": { "repeatElementPerItem": { "const": true } },
            "required": ["repeatElementPerItem"]
          },
          "then": { "required": ["itemElement"] }
        },
        {
          "if": {
            "properties": { "kind": { "enum": ["value", "attachment"] } },
            "required": ["kind"]
          },
          "then": {
            "properties": { "element": true },
            "required": ["element"],
            "not": {
              "anyOf": [
                { "properties": { "fields": true }, "required": ["fields"] },
                { "properties": { "items": true }, "required": ["items"] },
                { "properties": { "itemElement": true }, "required": ["itemElement"] },
                { "properties": { "itemNamespace": true }, "required": ["itemNamespace"] },
                { "properties": { "itemAttributes": true }, "required": ["itemAttributes"] },
                { "properties": { "repeatElementPerItem": true }, "required": ["repeatElementPerItem"] }
              ]
            }
          }
        }
      ]
    }
  }
}
