{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simpler.grants.gov/form-spec/contract/v1/policy-content.schema.json",
  "title": "Versioned policy content",
  "description": "Authoritative, source-pinned static policy text kept separate from response data and form identity.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "id", "version", "title", "kind", "sources", "sections"],
  "properties": {
    "contract": { "const": "policy-content/v1" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[a-z0-9/-]*[a-z0-9])?$" },
    "version": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["assurance", "certification", "disclosure", "notice"] },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/section" }
    }
  },
  "$defs": {
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId"],
      "properties": {
        "sourceId": { "type": "string", "minLength": 1 },
        "locator": { "type": "string", "minLength": 1 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "uri", "sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "enum": ["pdf", "dat", "xsd", "instructions", "web"] },
        "uri": { "type": "string", "format": "uri" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "retrievedAt": { "type": "string", "format": "date-time" },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "sourceRefs"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "ordinal": { "type": "integer", "minimum": 1 },
        "label": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceRef" }
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "title", "sourceRefs"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "role": { "enum": ["informational", "policy", "assurance", "certification", "notice"] },
        "title": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "note": { "type": "string", "minLength": 1 },
        "preamble": { "type": "string", "minLength": 1 },
        "presentationOrder": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["preamble", "text", "items", "note"] }
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/item" }
        },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceRef" }
        }
      },
      "anyOf": [
        { "required": ["text"], "properties": { "text": {} } },
        { "required": ["items"], "properties": { "items": {} } },
        { "required": ["note"], "properties": { "note": {} } },
        { "required": ["preamble"], "properties": { "preamble": {} } }
      ]
    }
  }
}
