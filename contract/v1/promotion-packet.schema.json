{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simpler.grants.gov/form-spec/contract/v1/promotion-packet.schema.json",
  "title": "Review-gated form evidence promotion packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "form", "extraction", "sources", "artifacts", "records",
    "behaviorEvidence", "runtimeRules", "semanticProposals", "reviewGates", "metrics"
  ],
  "properties": {
    "contract": { "const": "grants-form-promotion/v1" },
    "form": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "title", "sourceRoot"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "sourceRoot": { "type": "string", "minLength": 1 }
      }
    },
    "extraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "manifest", "extractedAt", "sourceSetSha256"],
      "properties": {
        "repository": { "type": "string", "pattern": "^https://" },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "manifest": { "$ref": "#/$defs/relativePath" },
        "extractedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
        },
        "sourceSetSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["uri", "sha256"],
        "properties": {
          "uri": { "type": "string", "pattern": "^https://" },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "role"],
        "properties": {
          "path": { "$ref": "#/$defs/relativePath" },
          "sha256": { "$ref": "#/$defs/sha256" },
          "role": {
            "enum": [
              "xsd_manifest", "xsd_records", "behavior_records", "authoring_contract",
              "component_proposals", "runtime_rules"
            ]
          }
        }
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/record" }
    },
    "behaviorEvidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/behaviorEvidence" }
    },
    "runtimeRules": {
      "type": "array",
      "items": { "$ref": "#/$defs/runtimeRule" }
    },
    "semanticProposals": {
      "type": "array",
      "items": { "$ref": "#/$defs/semanticProposal" }
    },
    "reviewGates": {
      "type": "array",
      "items": { "$ref": "#/$defs/reviewGate" }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceRecords", "sourceBehaviors", "applicantBehaviorRecords",
        "presentationBehaviorRecords", "runtimeRules", "semanticProposals",
        "acceptedSemanticMappings", "openReviewGates"
      ],
      "properties": {
        "sourceRecords": { "type": "integer", "minimum": 0 },
        "sourceBehaviors": { "type": "integer", "minimum": 0 },
        "applicantBehaviorRecords": { "type": "integer", "minimum": 0 },
        "presentationBehaviorRecords": { "type": "integer", "minimum": 0 },
        "runtimeRules": { "type": "integer", "minimum": 0 },
        "semanticProposals": { "type": "integer", "minimum": 0 },
        "acceptedSemanticMappings": { "const": 0 },
        "openReviewGates": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "relativePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "status"],
      "properties": {
        "value": {
          "enum": [
            "container", "unresolved", "applicant_question", "calculated_output",
            "technical_field", "static_content", "attachment"
          ]
        },
        "status": { "enum": ["deterministic", "proposed", "unreviewed"] }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceKey", "path", "recordKind", "dataType", "prompt", "required",
        "minOccurs", "maxOccurs", "constraints", "classification", "provenance"
      ],
      "properties": {
        "sourceKey": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "recordKind": { "type": "string", "minLength": 1 },
        "dataType": { "type": "string" },
        "prompt": { "type": "string" },
        "required": { "type": ["boolean", "null"] },
        "minOccurs": { "type": ["integer", "null"], "minimum": 0 },
        "maxOccurs": { "type": ["integer", "null"], "minimum": 0 },
        "constraints": { "type": "object" },
        "classification": { "$ref": "#/$defs/classification" },
        "provenance": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "behaviorEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "inputRole", "sourceRecord", "reviewStatus"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "inputRole": { "type": "string" },
        "sourceRecord": { "type": "object" },
        "reviewStatus": { "const": "unreviewed" }
      }
    },
    "runtimeRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "mechanism", "targetPath", "dependencyPaths", "effect", "operator",
        "disposition", "executionClass", "sourceRule", "provenance", "reviewStatus"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "mechanism": { "type": "string", "minLength": 1 },
        "targetPath": { "type": "string", "minLength": 1 },
        "dependencyPaths": { "type": "array", "items": { "type": "string" } },
        "effect": { "type": "string" },
        "operator": { "type": "string" },
        "value": {},
        "sourceValue": {},
        "disposition": { "type": "string", "minLength": 1 },
        "executionClass": { "type": "string", "minLength": 1 },
        "sourceRule": { "type": "string" },
        "provenance": { "type": "array", "items": { "type": "string" } },
        "reviewStatus": { "const": "proposed" }
      }
    },
    "semanticProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceKey", "sourcePath", "moduleIds", "role", "status", "publishable"],
      "properties": {
        "sourceKey": { "type": "string", "minLength": 1 },
        "sourcePath": { "type": "string", "minLength": 1 },
        "moduleIds": { "type": "array", "items": { "type": "string" } },
        "role": { "type": ["string", "null"] },
        "status": { "const": "proposed" },
        "publishable": { "const": false }
      }
    },
    "reviewGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "sourcePath", "status", "message"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": [
            "semantic_identity", "behavior_semantics", "attachment_semantics",
            "enum_wire_values", "source_conflict", "unsupported_projection"
          ]
        },
        "sourcePath": { "type": "string" },
        "status": { "const": "open" },
        "message": { "type": "string", "minLength": 1 }
      }
    }
  }
}
